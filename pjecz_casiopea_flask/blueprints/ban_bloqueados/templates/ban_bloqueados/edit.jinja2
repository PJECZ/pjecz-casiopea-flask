{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Editar Bloqueado {{ ban_bloqueado.id }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Editar Bloqueado ' + ban_bloqueado.id | string) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'ban_bloqueado_id': ban_bloqueado.id} %}
        {% call f.form_tag('ban_bloqueados.edit', fid='ban_bloqueado_form', **form_kwargs) %}
            {% call f.form_group(form.ban_tipo) %}{% endcall %}
            {% call f.form_group(form.direccion_ip) %}{% endcall %}
            {% call f.form_group(form.email) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
    {% endcall %}
{% endblock %}
