{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Editar Tipo de Envío {{ aut_tipo_envio.descripcion }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Editar Tipo de Envío ' + aut_tipo_envio.descripcion) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'aut_tipo_envio_id': aut_tipo_envio.id} %}
        {% call f.form_tag('aut_tipos_envios.edit', fid='aut_tipo_envio_form', **form_kwargs) %}
            {% call f.form_group(form.descripcion) %}{% endcall %}
            {% call f.form_group(form.activo) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
    {% endcall %}
{% endblock %}
