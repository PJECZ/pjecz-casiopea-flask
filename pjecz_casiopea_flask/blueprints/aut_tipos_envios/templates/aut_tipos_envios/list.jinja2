{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_view('AUT VERIFICACIONES USUARIOS') %}
            {{ topbar.button('Verificaciones de Usuarios', url_for('aut_verificaciones_usuarios.list_active'), 'mdi mdi-shield-key') }}
        {% endif %}
        {% if current_user.can_view('AUT VERIFICACIONES CLIENTES') %}
            {{ topbar.button('Verificaciones de Clientes', url_for('aut_verificaciones_clientes.list_active'), 'mdi mdi-shield-account') }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros Aut Tipos Envios -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosAutTiposEnvios.buscar(); return false;">
                    <div class="col-6">
                        <div class="form-floating">
                            <input id="filtroDescripcion" type="text" class="form-control" aria-label="Descripción" style="text-transform: uppercase;">
                            <label for="filtroDescripcion">Descripción</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosAutTiposEnvios.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosAutTiposEnvios.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable Aut Tipos Envios -->
        <table id="aut_tipos_envios_datatable" class="table display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Descripción</th>
                    <th>Activo</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="{{ url_for('static', filename='js/datatables-constructor.js') }}"></script>
    <script src="{{ url_for('static', filename='js/datatables-filtros.js') }}"></script>
    <script>
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTAutTiposEnvios = constructorDataTable.config();
        configDTAutTiposEnvios['ajax']['url'] = '{{ url_for("aut_tipos_envios.datatable_json") }}';
        configDTAutTiposEnvios['ajax']['data'] = {{ filtros }};
        configDTAutTiposEnvios['columns'] = [
            { data: 'detalle' },
            { data: 'descripcion' },
            { data: 'toggle_activo' }
        ];
        configDTAutTiposEnvios['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.id + '</a>';
                }
            },
            {
                targets: 2, // toggle_activo
                data: null,
                render: function(data, type, row, meta) {
                    if (data.url === '') {
                        if (data.es_activo === true) {
                            return '<span class="badge bg-primary">Activo</span>';
                        } else {
                            return '<span class="badge bg-secondary">Inactivo</span>';
                        }
                    }
                    let myId = 'aut_tipo_envio_activo_' + data.id;
                    let myRow = 'aut_tipo_envio_row_' + data.id;
                    let myOnClick = "toggleEsActivo('#" + myId + "', '" + data.url + "', '#" + myRow + "')";
                    if (data.es_activo === true) {
                        return '<button id="' + myId + '" type="button" class="btn btn-sm btn-outline-primary" onclick="' + myOnClick + '"><span class="mdi mdi-toggle-switch"></span></button>';
                    } else {
                        return '<button id="' + myId + '" type="button" class="btn btn-sm btn-light" onclick="' + myOnClick + '"><span class="mdi mdi-toggle-switch-off"></span></button>';
                    }
                }
            }
        ];
        const filtrosAutTiposEnvios = new FiltrosDataTable('#aut_tipos_envios_datatable', configDTAutTiposEnvios);
        filtrosAutTiposEnvios.agregarInput('filtroDescripcion', 'descripcion');
        filtrosAutTiposEnvios.precargar();
    </script>
    <!-- Datatables botones toggle_activo -->
    <script src="{{ url_for('static', filename='js/datatables-toggles.js') }}"></script>
    <script>
        // Preparar headers para POST
        const myHeaders = new Headers();
        myHeaders.append("X-CSRF-TOKEN", "{{ csrf_token() }}");
        const myInit = {
            method: "POST",
            headers: myHeaders,
            mode: "cors",
            cache: "default",
        };
    </script>
{% endblock %}
